{
  "name": "saffron-and-ember",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Next.js restaurant platform — phased implementation",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3003",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3003",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src next.config.ts",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check": "npm run typecheck && npm run lint",
    "legacy:dev": "node scripts/server.mjs",
    "legacy:test": "node --test test/*.test.js",
    "legacy:check": "node scripts/check.mjs",
    "legacy:build": "node scripts/build.mjs",
    "backup": "node scripts/backup.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" next.config.ts",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" next.config.ts",
    "test:database": "node --test tests/database.test.mjs tests/seed.test.mjs tests/staff-database.test.mjs tests/customer-database.test.mjs tests/checkout-database.test.mjs tests/support-database.test.mjs tests/reporting-database.test.mjs",
    "test:all": "npm test && npm run test:database && npm run test:images && npm run test:support-files && npm run legacy:test",
    "test:support-files": "node scripts/check-support-edge.mjs && node --test tests/support-files.test.mjs",
    "db:types": "node scripts/generate-database-types.mjs",
    "db:types:check": "node scripts/generate-database-types.mjs --check",
    "db:seed:generate": "node scripts/generate-development-seed.mjs",
    "test:auth:http": "node --use-system-ca --experimental-strip-types scripts/smoke-auth.mjs",
    "test:restore": "node --experimental-strip-types scripts/verify-database-restore.mjs",
    "db:types:hosted:check": "node scripts/compare-hosted-types.mjs",
    "test:images": "node --conditions=react-server --experimental-strip-types --test tests/image-processing.test.mjs",
    "preview:restart": "node scripts/restart-preview.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "lucide-react": "1.73.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.7.0",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-dialog": "1.3.1",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7",
    "@supabase/supabase-js": "2.119.0",
    "@supabase/ssr": "0.12.7",
    "server-only": "0.0.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "tailwindcss": "4.3.5",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "typescript": "5.9.3",
    "prettier": "3.10.1",
    "@electric-sql/pglite": "0.5.16",
    "supabase": "3.1.0"
  }
}
