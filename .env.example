# Next.js app. Copy this file to .env.local and fill in the connection settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
RESTAURANT_ID=
APP_URL=http://127.0.0.1:3003

# Legacy app. npm run legacy:dev creates .env with a generated admin password.
